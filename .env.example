# Postgres from docker compose (make migrate)
DATABASE_URL=postgres://activity:activity@localhost:5432/activity

# GraphQL API
PORT=4000

# Logging, see docs/logging.md#configuration
LOG_TERMINAL_LEVEL=info
LOG_FILE_LEVEL=info
LOG_FILE_DIR=./logs
LOG_FILE_RETENTION_DAYS=30
LOG_OTLP_LEVEL=off
OTEL_EXPORTER_OTLP_ENDPOINT=
